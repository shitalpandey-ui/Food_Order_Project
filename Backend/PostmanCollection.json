{
  "info": {
    "name": "Food Order API",
    "description": "Complete API collection for the Food Order Project backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "storeId",
      "value": ""
    },
    {
      "key": "menuId",
      "value": ""
    },
    {
      "key": "foodId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "resetToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"passwordConfirm\": \"password123\",\n  \"phoneNumber\": \"1234567890\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/user/signup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", "signup"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/user/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", "login"]
            },
            "description": "Login and receive JWT token. Save token to variable 'token' for protected routes."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/user/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", "logout"]
            }
          }
        },
        {
          "name": "Get User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/user/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", "me"]
            }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/user/forgetPassword",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", "forgetPassword"]
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"newpassword123\",\n  \"passwordConfirm\": \"newpassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/user/resetPassword/{{resetToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", "resetPassword", "{{resetToken}}"]
            }
          }
        },
        {
          "name": "Update Password",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"password123\",\n  \"newPassword\": \"newpassword123\",\n  \"newPasswordConfirm\": \"newpassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/user/password/update",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", "password", "update"]
            }
          }
        }
      ]
    },
    {
      "name": "Restaurants",
      "item": [
        {
          "name": "Get All Restaurants",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/restaurants/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "restaurants", ""]
            }
          }
        },
        {
          "name": "Get Single Restaurant",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/restaurants/{{storeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "restaurants", "{{storeId}}"]
            }
          }
        },
        {
          "name": "Create Restaurant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pizza Palace\",\n  \"isVeg\": false,\n  \"address\": \"123 Main Street, Mumbai\",\n  \"ratings\": 4.5,\n  \"location\": {\n    \"type\": \"Point\",\n    \"coordinates\": [72.8777, 19.0760]\n  },\n  \"images\": [\n    {\n      \"public_id\": \"default\",\n      \"url\": \"/images/restaurant.png\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/restaurants/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "restaurants", ""]
            }
          }
        },
        {
          "name": "Delete Restaurant",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/restaurants/{{storeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "restaurants", "{{storeId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Menus",
      "item": [
        {
          "name": "Get All Menus",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/menus/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "menus", ""]
            }
          }
        },
        {
          "name": "Create Menu",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restaurant\": \"{{storeId}}\",\n  \"menu\": [\n    {\n      \"category\": \"Starters\",\n      \"items\": []\n    },\n    {\n      \"category\": \"Main Course\",\n      \"items\": []\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/menus/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "menus", ""]
            }
          }
        },
        {
          "name": "Delete Menu",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/menus/{{menuId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "menus", "{{menuId}}"]
            }
          }
        },
        {
          "name": "Add Items to Menu",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"Starters\",\n  \"items\": [\"{{foodId}}\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/menus/{{menuId}}/items",
              "host": ["{{baseUrl}}"],
              "path": ["api", "menus", "{{menuId}}", "items"]
            }
          }
        }
      ]
    },
    {
      "name": "Food Items",
      "item": [
        {
          "name": "Get All Food Items by Store",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/fooditems/items/{{storeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "fooditems", "items", "{{storeId}}"]
            }
          }
        },
        {
          "name": "Get Single Food Item",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/fooditems/item/{{foodId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "fooditems", "item", "{{foodId}}"]
            }
          }
        },
        {
          "name": "Create Food Item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Margherita Pizza\",\n  \"price\": 299,\n  \"description\": \"Classic cheese pizza with tomato sauce\",\n  \"stock\": 50,\n  \"restaurant\": \"{{storeId}}\",\n  \"images\": [\n    {\n      \"public_id\": \"default\",\n      \"url\": \"/images/pizza.png\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/fooditems/item",
              "host": ["{{baseUrl}}"],
              "path": ["api", "fooditems", "item"]
            }
          }
        },
        {
          "name": "Update Food Item",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 349,\n  \"stock\": 40\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/fooditems/item/{{foodId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "fooditems", "item", "{{foodId}}"]
            }
          }
        },
        {
          "name": "Delete Food Item",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/fooditems/item/{{foodId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "fooditems", "item", "{{foodId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "Add to Cart",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"foodItemId\": \"{{foodId}}\",\n  \"restaurantId\": \"{{storeId}}\",\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/cart/add-to-cart",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cart", "add-to-cart"]
            }
          }
        },
        {
          "name": "Update Cart Item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"foodItemId\": \"{{foodId}}\",\n  \"quantity\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/cart/update-cart-item",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cart", "update-cart-item"]
            }
          }
        },
        {
          "name": "Delete Cart Item",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"foodItemId\": \"{{foodId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/cart/delete-cart-item",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cart", "delete-cart-item"]
            }
          }
        },
        {
          "name": "Get Cart",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cart/get-cart",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cart", "get-cart"]
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Get Single Order",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{orderId}}"]
            }
          }
        },
        {
          "name": "My Orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/me/myOrders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "me", "myOrders"]
            }
          }
        }
      ]
    }
  ]
}
